<UserControl x:Class="ProjetDevSysGraphical.ConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjetDevSysGraphical"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="MaxWidth" Value="400" />
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>
        
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TabControl>
            <TabItem Header="Log">
                <Border Grid.Row="1" Grid.Column="1" BorderBrush="Black" BorderThickness="2" Margin="10">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Name ="logTitle" Content="Log" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" HorizontalContentAlignment="Center" VerticalAlignment="Bottom"/>

                        <Label Name="logDailyLabel" Content="PathDaily" Grid.Row="1" Grid.Column="1"/>
                        <TextBox x:Name="logDailyEntry" Grid.Row="1" Grid.Column="2" />
                        <Button x:Name="logDailyExplorer" Grid.Row="1" Grid.Column="3" Content="&#x1F4CB;" Click="pathLogDailyExplorer_Click"/>


                        <Label Name="logRTLabel" Content="Path Log RT" Grid.Row="2" Grid.Column="1"/>
                        <TextBox x:Name="logRTEntry" Grid.Row="2" Grid.Column="2" />
                        <Button x:Name="logRTExplorer" Grid.Row="2" Grid.Column="3" Content="&#x1F4CB;" Click="pathLogRTExplorer_Click"/>

                        <Label Name="logExtensionlabel" Content="Select: " Grid.Row="3" Grid.Column="1"/>
                        <ComboBox Name="logExtensionSelector"  IsEditable="True" Grid.Row="3" Grid.Column="2" PreviewMouseDown="logExtensionSelector_GotFocus" GotFocus="logExtensionSelector_GotFocus">
                            <ComboBoxItem>.json</ComboBoxItem>
                            <ComboBoxItem>.xml</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="Crypto" Height="20" VerticalAlignment="Top">
                <Border Grid.Row="2" Grid.Column="1" BorderBrush="Black" BorderThickness="2" Margin="10">

                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Name="cryptoTitle" Content="Crypto" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>

                        <Label Name="cryptoPathLabel" Content="pathCrypto" Grid.Row="2" Grid.Column="1"/>
                        <TextBox x:Name="cryptoPathEntry" Grid.Row="2" Grid.Column="2"/>
                        <Button x:Name="cryptoPathExplorer" Grid.Row="2" Grid.Column="3" Content="&#x1F4CB;" Click="cryptoPathExplorer_Click"/>

                        <Label Name="cryptoExtensionsLabel" Content="extensionsCrypto" Grid.Row="3" Grid.Column="1"/>
                        <TextBox x:Name="cryptoExtensionsEntry" Grid.Row="3" Grid.Column="2"/>
                        <ListView Name="cryptoExtensionsListView"  Grid.Row="4" Grid.Column="2">
                            <ListView.View>
                                <GridView x:Name="cryptoExtensionsGridView">
                                    <GridViewColumn Header="Extension"  DisplayMemberBinding="{Binding extension}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <Button Name="cryptoExtensionsAdd" Grid.Row="3"  Grid.Column="3" Margin="5" Background="LightGreen" Foreground="Green" Click="cryptoExtensionsAdd_Click" Width="20" Height="20">+</Button>
                        <Button Name="cryptoExtensionsRemove" Grid.Row="4"  Grid.Column="3" Margin="5" Background="Red" Foreground="DarkRed" VerticalAlignment="Top" Click="cryptoExtensionsRemove_Click" Width="20" Height="20">-</Button>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="Languages">
                <Border Grid.Row="3" Grid.Column="1" BorderBrush="Black" BorderThickness="2" Margin="10">

                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Name="languageTitle" Content="Languages" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>

                        <Label Name="languageLabel" Content="Select: " Grid.Row="2" Grid.Column="1"/>
                        <ComboBox Name="languageSelector"  IsEditable="True" Grid.Row="2" Grid.Column="2" PreviewMouseDown="languageSelector_GotFocus" GotFocus="languageSelector_GotFocus">
                            <ComboBoxItem>English</ComboBoxItem>
                            <ComboBoxItem>Francais</ComboBoxItem>
                        </ComboBox>

                    </Grid>
                </Border>

            </TabItem>
            <TabItem Header="Blocker">
                <Border Grid.Row="4" Grid.Column="1" BorderBrush="Black" BorderThickness="2" Margin="10">

                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Name="blockerTitle" Content="Blocker" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>

                        <Label Name="blockerLabel" Content="extensionsCrypto" Grid.Row="2" Grid.Column="1"/>
                        <TextBox x:Name="blockerEntry" Grid.Row="2" Grid.Column="2"/>
                        <ListView Name="blockerListView"  Grid.Row="3" Grid.Column="2">
                            <ListView.View>
                                <GridView x:Name="blockerGridView">
                                    <GridViewColumn Header="processes"  DisplayMemberBinding="{Binding process}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <Button Name="blockerAdd" Grid.Row="2"  Grid.Column="3" Margin="5" Background="LightGreen" Foreground="Green" Click="blockerAdd_Click" Width="20" Height="20">+</Button>
                        <Button Name="blockerRemove" Grid.Row="3"  Grid.Column="3" Margin="5" Background="Red" Foreground="DarkRed" VerticalAlignment="Top" Click="blockerRemove_Click" Width="20" Height="20">-</Button>
                    </Grid>
                </Border>

            </TabItem>
            <TabItem Header="Save Path">
                <Border Grid.Row="5" Grid.Column="1" BorderBrush="Black" BorderThickness="2" Margin="10">

                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label Name="SavePath" Content="Save Path" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>


                        <Label Name="pathSaveBackupsLabel" Content="pathSaves" Grid.Row="3" Grid.Column="1"/>
                        <TextBox x:Name="pathSaveBackupEntry" Grid.Row="3" Grid.Column="2" />
                        <Button x:Name="pathSaveBackupExplorer" Grid.Row="3" Grid.Column="3" Content="&#x1F4CB;" Click="pathSaveBackupExplorer_Click"/>

                    </Grid>
                </Border>

            </TabItem>
        </TabControl>
        <Button x:Name="ApplyButton" Grid.Row="1" Grid.Column="0" Margin="5" HorizontalAlignment="Left" Click="ApplyButton_Click">
            Apply
        </Button>
        <Button x:Name="ResetButton" Grid.Row="1" Grid.Column="0" Margin="5" VerticalAlignment="Stretch" HorizontalAlignment="Right" Click="ResetButton_Click">
            Reset
        </Button>
    </Grid>
</UserControl>
