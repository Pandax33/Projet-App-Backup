<Window x:Class="ProjetDevSysGraphical.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjetDevSysGraphical"
        mc:Ignorable="d"
        Title="EasySave" Height="450" Width="800">
    <Grid>
        <TextBlock x:Name="textBlockTitle" HorizontalAlignment="Center" TextWrapping="Wrap" Text="EasySave" VerticalAlignment="Top" Height="50" Width="427" FontSize="30" Margin="0,10,0,0"/>
        <Button x:Name="button" Content="Ajouter une tâche" HorizontalAlignment="Right" VerticalAlignment="Top" Width="135" Click="ButtonAdd_Click" Height="50" Margin="0,20,30,0"/>
        <Button x:Name="launchSelectedTasks" Content="Lancer les tâches selectionnées" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="200" Click="ButtonlaunchSelectedTasks_Click" Height="50" Margin="20,0,0,20" Grid.Row="1"/>
        <Button x:Name="launchAllTasks" Content="Lancer les tâches sur cette page" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="200" Click="ButtonlaunchAllTasks_Click" Height="50" Margin="0,0,30,20"/>

        <!-- Ajout du DataGrid -->
        <DataGrid x:Name="dataGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10,80,10,80" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding Propriete1}" Width="*" />
                <DataGridTextColumn Header="Source" Binding="{Binding Propriete2}" Width="*" />
                <DataGridTextColumn Header="Cible" Binding="{Binding Propriete3}" Width="*" />
                <DataGridTextColumn Header="Type" Binding="{Binding Propriete4}" Width="*" />
                <DataGridTextColumn Header="Colonne 5" Binding="{Binding Propriete5}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
