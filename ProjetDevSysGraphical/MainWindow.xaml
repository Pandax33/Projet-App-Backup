<Window Closing="MainWindow_Closed"
        x:Class="ProjetDevSysGraphical.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjetDevSysGraphical"
        mc:Ignorable="d"
        Title="EasySave" MinHeight="400" Height="450" MaxHeight="800" MinWidth="750" Width="800" MaxWidth="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Barre de navigation -->
            <ColumnDefinition Width="*"/>
            <!-- Contenu existant -->
        </Grid.ColumnDefinitions>

        <!-- Barre de navigation -->
        <StackPanel Grid.Column="0" VerticalAlignment="Top">
            <Button Content="Accueil" HorizontalAlignment="Stretch" Margin="10" Click="Home_Click"/>
            <Button Content="Sauvegarde" HorizontalAlignment="Stretch" Margin="10" Click="Backup_Click"/>
            <Button Content="Configuration" HorizontalAlignment="Stretch" Margin="10" Click="Settings_Click"/>
        </StackPanel>

        <!-- Contenu existant déplacé dans la deuxième colonne -->
        <Grid Grid.Column="1">
            <ContentControl x:Name="contentControl" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="10"/>
            
            
        </Grid>
    </Grid>
</Window>
