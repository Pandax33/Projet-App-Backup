<UserControl x:Class="ProjetDevSysGraphical.Backup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjetDevSysGraphical"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Button x:Name="button" Content="{local:LangageExtension Key='Task.AddButton'}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="136" Click="ButtonAdd_Click" Height="50" Margin="0,0,10,20"/>
        <Button x:Name="launchSelectedTasks" Content="{local:LangageExtension Key='Task.LaunchSelect'}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="200" Click="ButtonlaunchSelectedTasks_Click" Height="50" Margin="10,0,0,20"/>
        <Button x:Name="launchAllTasks" Content="{local:LangageExtension Key='Task.LaunchAll'}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="200" Click="ButtonlaunchAllTasks_Click" Height="50" Margin="234,0,0,20"/>
        <ListView x:Name="listView" Margin="10,80,10,80">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{local:LangageExtension Key='Task.Grid.Name'}" DisplayMemberBinding="{Binding Propriete1}" />
                    <GridViewColumn Header="{local:LangageExtension Key='Task.Grid.Source'}" DisplayMemberBinding="{Binding Propriete2}" />
                    <GridViewColumn Header="{local:LangageExtension Key='Task.Grid.Target'}" DisplayMemberBinding="{Binding Propriete3}" />
                    <GridViewColumn Header="{local:LangageExtension Key='Task.Grid.Type'}" DisplayMemberBinding="{Binding Propriete4}" />
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel x:Name="stackPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Width="186" Margin="0,80,10,0"/>
    </Grid>
</UserControl>
