<UserControl x:Class="ProjetDevSysGraphical.Backup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProjetDevSysGraphical"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Button x:Name="button" Content="Ajouter une tâche" HorizontalAlignment="Right" VerticalAlignment="Top" Width="135" Click="ButtonAdd_Click" Height="50" Margin="0,20,30,0"/>
        <Button x:Name="launchSelectedTasks" Content="Lancer les tâches selectionnées" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="200" Click="ButtonlaunchSelectedTasks_Click" Height="50" Margin="20,0,0,20"/>
        <Button x:Name="launchAllTasks" Content="Lancer les tâches sur cette page" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="200" Click="ButtonlaunchAllTasks_Click" Height="50" Margin="0,0,30,20"/>
        <ListView x:Name="listView" Margin="10,80,10,80">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Nom" DisplayMemberBinding="{Binding Propriete1}" />
                    <GridViewColumn Header="Source" DisplayMemberBinding="{Binding Propriete2}" />
                    <GridViewColumn Header="Cible" DisplayMemberBinding="{Binding Propriete3}" />
                    <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Propriete4}" />
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel x:Name="stackPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Width="186" Margin="0,80,10,0"/>
    </Grid>
</UserControl>
